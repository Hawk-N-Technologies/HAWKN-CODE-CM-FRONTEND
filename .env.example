# ==============================================================================
# HawkN OS Frontend - Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# Application Environment (development / staging / production)
VITE_APP_ENV=development
VITE_APP_NAME="HawkN OS"

# Active Server Port (used by Vite dev, preview, Docker, and Nginx)
# If left empty, automatically resolves to PORT_PROD or PORT_STAGE based on VITE_APP_ENV
PORT=12123

# Active Backend URLs (without trailing slashes)
# Used by Vite proxy, Socket.IO, Nginx reverse proxy, and API services.
# If left empty, automatically resolves to STAGE or PROD URLs based on VITE_APP_ENV
VITE_BACKEND_URL=https://clientportalapi.hawkntechnologies.com
VITE_API_BASE_URL=https://clientportalapi.hawkntechnologies.com/api

# ------------------------------------------------------------------------------
# Staging Environment Presets
# ------------------------------------------------------------------------------
PORT_STAGE=12123
VITE_BACKEND_URL_STAGE=https://clientportalapi.hawkntechnologies.com
VITE_API_BASE_URL_STAGE=https://clientportalapi.hawkntechnologies.com/api

# ------------------------------------------------------------------------------
# Production Environment Presets
# ------------------------------------------------------------------------------
PORT_PROD=43214
VITE_BACKEND_URL_PROD=https://osapi.hawkntechnologies.com
VITE_API_BASE_URL_PROD=https://osapi.hawkntechnologies.com/api
