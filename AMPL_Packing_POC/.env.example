# AMPL Packing POC frontend. Copy to .env if you need to change these.

# Port for the dev server
PORT=5180

# Where the AMPL backend runs (the dev server forwards /api here)
VITE_API_PROXY_TARGET=http://localhost:8010

# Phone testing: the camera only works on https://.
# true = serve https using the certificate in .cert/ (see README)
VITE_DEV_HTTPS=false
VITE_DEV_HTTPS_KEY=.cert/key.pem
VITE_DEV_HTTPS_CERT=.cert/cert.pem
